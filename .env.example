# Copy to .env in this directory. Local development only; replace before deployment.
DATABASE_URL=postgresql://privacylens:local_development_only@localhost:5432/privacylens?schema=public
POSTGRES_USER=privacylens
POSTGRES_PASSWORD=local_development_only
POSTGRES_DB=privacylens
PORT=4000
NODE_ENV=development
WEB_ORIGINS=http://localhost:5173
SESSION_TTL_HOURS=24
