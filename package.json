{
  "name": "privacylens-pro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @privacylens/api\" \"npm run dev -w @privacylens/web\"",
    "build": "npm run build --workspaces --if-present",
    "build:extension:production": "node scripts/build-extension-production.mjs",
    "security": "npm run security:repo",
    "security:repo": "node scripts/security-repo.mjs",
    "test:publication": "node --test scripts/publication-policy.test.mjs",
    "release": "npm run release:check",
    "release:check": "node scripts/release-check.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "evaluate": "node scripts/evaluate.mjs",
    "evaluate:check": "node scripts/evaluate.mjs --check",
    "benchmark:backend": "node scripts/benchmark-backend.mjs",
    "research:report": "node scripts/research-report.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "npm run db:generate -w @privacylens/api",
    "db:check": "node scripts/database-check.mjs",
    "db:validate": "npm run db:validate -w @privacylens/api",
    "db:migrate": "node scripts/database-admin.mjs migrate application",
    "db:seed": "node scripts/database-admin.mjs seed application",
    "db:migrate:test": "node scripts/database-admin.mjs migrate test",
    "db:seed:test": "node scripts/database-admin.mjs seed test",
    "db:inspect": "node scripts/database-admin.mjs inspect",
    "verify:extension": "node scripts/verify-extension.mjs",
    "test:smoke": "node scripts/smoke-api.mjs",
    "test:browser-scanner": "node scripts/browser-scanner-smoke.mjs",
    "test:browser-dashboard": "node scripts/browser-dashboard-smoke.mjs",
    "test:browser-sync": "node scripts/browser-dashboard-smoke.mjs --extension-sync",
    "dev:fixtures": "node scripts/fixture-server.mjs --serve"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "esbuild": "0.28.2",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "5.0.5"
  }
}
