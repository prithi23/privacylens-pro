# PLACEHOLDERS ONLY. Copy to deploy/.env.production on the approved host.
# Do not reuse your local application/test database or paste secrets into Git.
PUBLIC_DOMAIN=privacy.example.com
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:5432/REPLACE_DATABASE?sslmode=verify-full
SESSION_TTL_HOURS=24
# Optional provider CA mount: NODE_EXTRA_CA_CERTS=/run/secrets/postgres_ca.pem
